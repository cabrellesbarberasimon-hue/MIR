# Base de datos Postgres (Neon). En local puede ser un Postgres propio.
DATABASE_URL=postgres://usuario:contraseña@host:5432/mir

# Contraseña de acceso a la app (un único usuario)
APP_PASSWORD=
# Secreto para firmar la cookie de sesión (cadena aleatoria larga: openssl rand -hex 32)
SESSION_SECRET=

# Solo para los scripts locales de manuales/tarjetas (no hace falta en Vercel)
ANTHROPIC_API_KEY=
# Carpeta de manuales (solo lectura). En Windows, entre comillas simples si tiene espacios:
MANUALES_DIR='C:\Users\Simo\OneDrive - BoCubi\Escritorio\MANUALES'
